# --- Supabase & Database ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
DATABASE_URL=sqlite:///./brandguard.db

# --- Security & Auth ---
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRE_MIN=720
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DEMO_MODE=true

# --- Optional: SMTP Email Delivery (Gmail) ---
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Gemini & LLM Base ---
LLM_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
LLM_TIMEOUT_S=8

# --- Round 3 Feature Flags ---
INGESTION_ENABLED=true
VISION_ENABLED=true
SEMANTIC_ENABLED=false
GAP_ANALYSIS_ENABLED=true

# --- Round 3 Gemini & Vision & Embeddings ---
GEMINI_VISION_MODEL=gemini-2.5-flash
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIM=768
GEMINI_MIN_INTERVAL_S=4.2
VISION_MODE=live
EXTRACTION_MODE=ai

# --- Limits ---
INGEST_MAX_MB=15
INGEST_MAX_PAGES=60
INGEST_CHUNK_CHARS=8000
ASSET_MAX_MB=5
ASSET_MAX_PIXELS=40000000
ASSET_MAX_ACTIVE_PER_SUBMISSION=5

# --- Thresholds ---
SEMANTIC_FLAG_THRESHOLD=0.82
SEMANTIC_REVIEW_THRESHOLD=0.74
SEMANTIC_INCLUDE_FACTS=true
SEMANTIC_MAX_SENTENCES=40
SEMANTIC_TIMEOUT_S=6
PALETTE_MAX_DELTA_E=25
PALETTE_MIN_SHARE=0.06
WCAG_MIN_RATIO=4.5
GAP_MIN_FIRED=5
GAP_DISPUTE_RATE=0.4
GAP_CLUSTER_COSINE=0.78
