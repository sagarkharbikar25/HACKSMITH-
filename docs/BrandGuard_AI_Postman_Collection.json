                  "        var json = pm.response.json();",
                  "        pm.expect(json.error.code).to.eql('RATE_LIMIT_EXCEEDED');",
                  "    });",
                  "} else {",
                  "    pm.test('Request allowed within rate limit (200 OK)', function () {",
                  "        pm.response.to.have.status(200);",
